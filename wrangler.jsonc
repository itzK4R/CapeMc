{
  // The name must match your existing Worker (your site address starts with it).
  "name": "capemc",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  // Your website files are served as they are; only /api/* runs the Worker.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Fill in both values from Cloudflare > Storage & databases > D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_DATABASE_NAME",
      "database_id": "YOUR_DATABASE_ID"
    }
  ]
}
